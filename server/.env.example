PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/inkpaw
CLIENT_ORIGIN=http://localhost:5173

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Used to derive unlinkable anonymous author IDs in the community
ANON_SECRET=change-me-too
# Used to give unknown emails a stable decoy salt (prevents account enumeration)
SALT_PEPPER=change-me-three

NODE_ENV=development
